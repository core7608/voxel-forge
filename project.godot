; Engine configuration file.
; Voxel Forge — Voxel Building/Survival Prototype (Godot 4.4)
; Kenney + KayKit style, structural integrity building.

config_version=5

[application]

config/name="Voxel Forge Prototype"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputBridge="*res://scripts/autoload/input_bridge.gd"
Blocks="*res://scripts/autoload/block_registry.gd"
ServerConfig="*res://scripts/autoload/server_config.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Game="*res://scripts/autoload/game.gd"
World="*res://scripts/autoload/world.gd"
Crafting="*res://scripts/autoload/crafting.gd"
Net="*res://scripts/autoload/net_manager.gd"
Saves="*res://scripts/autoload/save_manager.gd"
CityManager="*res://scripts/autoload/city_manager.gd"
Mods="*res://scripts/autoload/mod_loader.gd"

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.47, 0.65, 0.85, 1)
